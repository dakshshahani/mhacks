# Copy to .env (never commit). Load with: node --env-file=.env …
# Keys are read from process.env only — see packages/orchestrator/src/env.ts.
TYPESAFE_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Generate-from-brief (voice-to-project). OpenAI-style /chat/completions;
# default is opencode Zen (verified: glm-5.3-flash on /zen/v1).
GLM_API_KEY=
GLM_BASE_URL=https://opencode.ai/zen/v1
GLM_MODEL=glm-5.3-flash
