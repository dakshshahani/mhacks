{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Harness client is plain JS (present but unchecked); TS sources added
    // later typecheck strictly. Only node ambient types: transitive @types
    // from harness deps are not installed and must not leak in.
    "allowJs": true,
    "checkJs": false,
    "types": ["node"]
  },
  "include": ["src"]
}
